[Unit]
Description=MyProxy Dual-Mode Network Gateway
Documentation=https://github.com/yourusername/myProxy
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=forking
RemainAfterExit=true
User=root
Group=root
WorkingDirectory=/home/raspberrypi/myProxy

# Start MyProxy containers
ExecStart=/usr/bin/docker-compose -f docker-compose.pi.yml up -d

# Stop command  
ExecStop=/usr/bin/docker-compose -f docker-compose.pi.yml down

# Reload: Restart containers
ExecReload=/usr/bin/docker-compose -f docker-compose.pi.yml restart

# Restart policy
TimeoutStartSec=180
TimeoutStopSec=60
Restart=always
RestartSec=30

# Environment
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="DOCKER_HOST=unix:///var/run/docker.sock"

# Security settings (relaxed for network gateway functionality)
PrivateTmp=false
NoNewPrivileges=false
PrivateNetwork=false

# Resource limits  
LimitNOFILE=1048576
LimitNPROC=1048576

[Install]
WantedBy=multi-user.target