[Unit]
Description=MyProxy Dual-Mode Network Gateway
Documentation=https://github.com/yourusername/myProxy
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=forking
RemainAfterExit=true
User=root
Group=root
WorkingDirectory=/home/pi/myProxy

# Pre-start: Detect and configure mode
ExecStartPre=/bin/bash -c 'cd /home/pi/myProxy/scripts/pi-deployment && ./detect-mode.sh > /tmp/myproxy-mode.log 2>&1'
ExecStartPre=/bin/bash -c 'source /etc/myproxy/mode.conf && export MYPROXY_MODE WAN_INTERFACE LAN_INTERFACE'

# Start MyProxy in detected mode
ExecStart=/bin/bash -c 'source /etc/myproxy/mode.conf && docker-compose -f docker-compose.pi.yml up -d'

# Stop command
ExecStop=/usr/bin/docker-compose -f docker-compose.pi.yml down

# Reload: Switch modes if requested
ExecReload=/bin/bash -c 'cd /home/pi/myProxy/scripts/pi-deployment && ./switch-mode.sh auto'

# Restart policy
TimeoutStartSec=180
TimeoutStopSec=60
Restart=always
RestartSec=30

# Environment
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="DOCKER_HOST=unix:///var/run/docker.sock"

# Security settings (relaxed for network gateway functionality)
PrivateTmp=false
NoNewPrivileges=false
PrivateNetwork=false

# Resource limits  
LimitNOFILE=1048576
LimitNPROC=1048576

[Install]
WantedBy=multi-user.target