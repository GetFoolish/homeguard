# MyProxy Configuration
# Copy this file to .env and modify as needed

# Debug mode
MYPROXY_DEBUG=true
MYPROXY_LOG_LEVEL=INFO

# Database
MYPROXY_DATABASE_URL=sqlite+aiosqlite:///myproxy.db

# Network settings (for production deployment)
MYPROXY_GATEWAY_INTERFACE=eth0
MYPROXY_CLIENT_INTERFACE=wlan0
MYPROXY_GATEWAY_IP=192.168.1.1

# Web interface
MYPROXY_WEB_HOST=0.0.0.0
MYPROXY_WEB_PORT=8080

# Admin credentials
MYPROXY_ADMIN_USERNAME=admin
MYPROXY_ADMIN_PASSWORD=change_me_please

# Google Sheets integration (optional)
MYPROXY_GOOGLE_SHEETS_ID=
MYPROXY_GOOGLE_SERVICE_ACCOUNT_PATH=

# Auto-recovery settings
MYPROXY_AUTO_RECOVERY=true
MYPROXY_MAX_RESTART_ATTEMPTS=3
MYPROXY_HEALTH_CHECK_INTERVAL=30